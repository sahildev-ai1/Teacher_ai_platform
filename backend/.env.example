# --- Ollama ---
# Leave OLLAMA_HOST empty to use Ollama Cloud (requires OLLAMA_API_KEY).
# Set OLLAMA_HOST=http://localhost:11434 to use a local daemon instead.
OLLAMA_HOST=
OLLAMA_API_KEY=your_ollama_cloud_api_key
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_FAST_MODEL=gemma4:cloud

# --- Embeddings ---
# The embedding model (sentence-transformers/all-MiniLM-L6-v2) is a PUBLIC,
# non-gated Hugging Face model -- fastembed downloads it anonymously, no
# token required. HF_TOKEN below is OPTIONAL: it only helps if you ever hit
# Hugging Face's anonymous rate limit or a transient "auth required" hiccup
# on their end. Leave blank unless you actually see download errors.
HF_TOKEN=

# --- Optional: pedagogy-only enrichment (analogies/teaching-strategy ideas) ---
# Leave blank to disable -- the app works fine without it.
TAVILY_API_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Storage (fine as-is for local/dev; see README for Render notes) ---
SQLITE_PATH=./data/tkp.db
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

ENFORCE_SINGLE_DOCUMENT=true
